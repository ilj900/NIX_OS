{
    "layer": "top",
    "position": "top",
    "height": 50,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["custom/blender", "custom/clion", "custom/clion-hip"],
    "modules-right": ["hyprland/language", "pulseaudio", "tray", "clock", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}"
    },
    "clock": {
        "format": "{:%H:%M   %a %d %b}"
    },
    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "eth ",
        "format-disconnected": "disconnected"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-icons": ["", "", ""],
        "on-click": "~/.config/waybar/scripts/switch-audio-sink.sh",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },
    "tray": {
        "spacing": 10,
        "icon-size": 24
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-ru": "RU",
        "on-click": "hyprctl switchxkblayout current next"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power_menu.sh"
    },
    "custom/clion": {
        "format": "VK",
        "tooltip": true,
        "tooltip-format": "CLion with Vulkan env",
        "on-click": "clion-vk"
    },
    "custom/clion-hip": {
        "format": "HIP",
        "tooltip": true,
        "tooltip-format": "CLion with HIP env",
        "on-click": "clion-hip"
    },
    "custom/blender": {
        "format": " ",
        "tooltip": true,
        "tooltip-format": "Blender",
        "on-click": "blender"
    }
}
